# SLIDE AI — Muhit o‘zgaruvchilari (Environment Variables)

# 1. Supabase konfiguratsiyasi (Ixtiyoriy - bo'sh qoldirilsa, LocalStorage Demo rejimida ishlaydi)
VITE_SUPABASE_URL=your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. AI API kaliti (Ixtiyoriy - bo'sh qoldirilsa, aqlli mahalliy generator ishlaydi)
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_OPENAI_API_KEY=your-openai-api-key
